@{
    ViewData["Title"] = "Product Home";
}

<div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded-xl shadow-md border border-gray-100">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Welcome to My ERP</h1>
    <p class="text-gray-600 mb-6">This is my first ASP.NET Core MVC Project.</p>
    <h3 class="text-xl font-semibold text-gray-800 mb-3">ERP Modules</h3>
    <ul class="list-disc list-inside space-y-2 text-gray-700 mb-6">
        <li>Product Management</li>
        <li>Inventory Management</li>
        <li>Sales Management</li>
        <li>Accounting</li>
    </ul>
    <button class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-5 rounded-lg shadow transition">
        Get Started
    </button>
</div>
